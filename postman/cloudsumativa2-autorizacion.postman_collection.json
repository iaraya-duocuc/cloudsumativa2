                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const eventoId = pm.variables.get(\"eventoId\");",
                      "if (!/^[1-9][0-9]*$/.test(String(eventoId ?? \"\"))) {",
                      "    console.error(\"Falta un eventoId válido. Ejecuta Crear evento como administrador o completa eventoId en Variables.\");",
                      "    pm.execution.skipRequest();",
                      "}"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Estado esperado [200]\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                      "pm.test(\"Cero reservas y diez cupos\", () => { const data = pm.response.json(); pm.expect(data.totalReservas).to.eql(0); pm.expect(data.cuposDisponibles).to.eql(10); });",
